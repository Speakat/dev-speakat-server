{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "Jwt": {
    "AccessTokenExpirationMinutes": 30
  },
  "AWS": {
    "Region": "{Region}",
    "BucketName": "{BucketName}",
    "AccessKeyId": "{AccessKeyId}",
    "SecretAccessKey": "{SecretAccessKey}"
  },
  "AllowedHosts": "*"
}
